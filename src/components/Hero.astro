---
const { name, tagline, picture, resume, socials } = Astro.props;
---

<section class="hero">
  <img
    class="profile-picture"
    src={picture}
    alt={`Portrait of ${name}`}
  />

  <div class="hero-text">
    <h1>Hello, I'm {name}!</h1>

    <p>{tagline}</p>

    <div class="hero-links">
      {socials.map((socials) => (
        <a href={socials.url}>{socials.label}</a>
      ))}

      <a href={resume}>Resume</a>
    </div>
  </div>
</section>