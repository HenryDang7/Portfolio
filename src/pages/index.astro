---
/* Components*/
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";

/* Assets */
import headshot from "../assets/headshot.jpg"

/* Content */
const heroSection = {
  header: "About",
  img: headshot
}
---

<BaseLayout title="Henry Dang | Mech E">
  <HeroSection header={heroSection.header} img={heroSection.img}>
    <p>Hi, welcome to my niche corner of the internet! I'm Henry, a current mechanical engineering undergrad at MIT (Course 2).</p>
    <p>I love hands-on making when I have the time; though, that's not all I do. What my major doesn't tell you is that I also enjoy working with computers, logic & architectures, and a bit of "practical-theory".</p>
    <p>When I'm not in the shop, you can find me hanging out with my friends; whether I'm organizing an event, mentoring in makerspaces, or even restoring "old" stuff, I love to have company!</p>
  </HeroSection>

  <section>
    <h1>Goals for Portfolio</h1>
    <p></p>
  </section>
</BaseLayout>